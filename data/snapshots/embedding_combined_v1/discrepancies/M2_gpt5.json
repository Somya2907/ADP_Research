    {
      "teacher_id": "A2",
      "node_type": "A",
      "label": "TenantRank screens prospective tenants for rental housing. Housing is explicitly enumerated in Section 6-1-1701(3)(f) as a consequential decision domain.",
      "weight": 2.5
    },
    {
      "teacher_id": "A3",
      "node_type": "A",
      "label": "96% denial rate for sub-40 scores and 88% approval for above-60 scores, combined with VP directive to almost never approve low scorers, demonstrates TenantRank materially contributes to decisions. Human review is based primarily on AI output per Section 6-1-1701(9).",
      "weight": 2.5
    },
    {
      "teacher_id": "A4",
      "node_type": "A",
      "label": "TenantRank is an AI system that is a substantial factor in making consequential housing decisions. No exceptions in Section 6-1-1701(7)(a)-(d) apply - it does not perform narrow procedural tasks, improve prior human activity, merely detect patterns, or perform preparatory tasks. TenantRank is a high-risk AI system.",
      "weight": 2.5
    },
